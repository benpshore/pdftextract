+#[test]
+fn flatten_precision_retains_exact_tiny_scale_and_ordinary_controls() {
+    for kind in [FlattenCarrierKind::Annotation, FlattenCarrierKind::Form] {
+        for (label, extent) in [("tiny-exact", 100_000_000), ("ordinary", 100)] {
+            let source = precision_appearance_fixture(kind, extent);
+            let prefix = format!("flatten-precision-{}-{label}", kind.name());
+            capture_form_fixture(&format!("{prefix}-source.pdf"), &source);
+            let output = one_pdf(kind.adapter(source).unwrap());
+            capture_form_fixture(&format!("{prefix}-control.pdf"), &output);
+            let corners = serialized_appearance_corners(&output);
+            assert!(appearance_corner_error(corners) <= 0.001, "{corners:?}");
+        }
+    }
+}
