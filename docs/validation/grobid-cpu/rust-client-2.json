>Sample</surname></persName>\n\t\t\t\t\t\t\t<affiliation key=\"aff0\" coords=\"1,50.00,103.49,241.35,9.90\">\n\t\t\t\t\t\t\t\t<note type=\"raw_affiliation\">Department of Computer Science , Example University</note>\n\t\t\t\t\t\t\t\t<orgName type=\"department\">Department of Computer Science</orgName>\n\t\t\t\t\t\t\t\t<orgName type=\"institution\">Example University</orgName>\n\t\t\t\t\t\t\t</affiliation>\n\t\t\t\t\t\t</author>\n\t\t\t\t\t\t<title level=\"a\" type=\"main\" xml:id=\"_YNXAzY2\" coords=\"1,50.00,49.71,397.48,16.20\">Synthetic Study of Reproducible Document Processing</title>\n\t\t\t\t\t</analytic>\n\t\t\t\t\t<monogr>\n\t\t\t\t\t\t<imprint>\n\t\t\t\t\t\t\t<date type=\"published\" when=\"2026-10\">October 2026</date>\n\t\t\t\t\t\t</imprint>\n\t\t\t\t\t</monogr>\n\t\t\t\t\t<idno type=\"MD5\">16A9BD23C9BC9981F5EE197E6D2D9F17</idno>\n\t\t\t\t</biblStruct>\n\t\t\t</sourceDesc>\n\t\t</fileDesc>\n\t\t<encodingDesc>\n\t\t\t<appInfo>\n\t\t\t\t<application version=\"0.9.1\" ident=\"GROBID\" when=\"2026-10-04T02:34+0000\">\n\t\t\t\t\t<desc>GROBID - A machine learning software for extracting information from scholarly documents</desc>\n\t\t\t\t\t<label type=\"revision\">0.9.1</label>\n\t\t\t\t\t<label type=\"parameters\">startPage=-1, endPage=-1, consolidateCitations=0, consolidateHeader=0, consolidateFunders=0, includeRawAffiliations=true, includeRawCitations=true, includeRawCopyrights=true, generateTeiIds=true, generateTeiCoordinates=[head, p, s, ref, biblStruct, figure, formula, title, persName, affiliation, note], flavor=null, debugLabelingCollector=disabled</label>\n\t\t\t\t\t<ref target=\"https://github.com/kermitt2/grobid\"/>\n\t\t\t\t</application>\n\t\t\t</appInfo>\n\t\t</encodingDesc>\n\t\t<profileDesc>\n\t\t\t<abstract>\n<div xmlns=\"http://www.tei-c.org/ns/1.0\" xml:id=\"_Adem26R\"><p xml:id=\"_k6KwSX7\" coords=\"1,50.00,173.49,332.99,9.90\">We describe a benign synthetic study of reproducible document processing.</p></div>\n\t\t\t</abstract>\n\t\t</profileDesc>\n\t</teiHeader>\n\t<facsimile>\n\t\t<surface n=\"1\" ulx=\"0.0\" uly=\"0.0\" lrx=\"612.0\" lry=\"792.0\"/>\n\t\t<surface n=\"2\" ulx=\"0.0\" uly=\"0.0\" lrx=\"612.0\" lry=\"792.0\"/>\n\t</facsimile>\n\t<text xml:lang=\"en\">\n\t\t<body>\n<div xmlns=\"http://www.tei-c.org/ns/1.0\" xml:id=\"_kdAuvSP\"><p xml:id=\"_zK99mz7\" coords=\"1,50.00,213.44,79.72,12.60;1,50.00,243.49,331.14,9.90\">1 Introduction Document processing requires explicit provenance and preserved originals.</p><p xml:id=\"_nJyP2Wp\" coords=\"1,50.00,264.49,316.18,9.90\">Example and Sample (2024) describe a controlled validation procedure.</p><p xml:id=\"_QAa3yZj\" coords=\"1,50.00,285.49,326.28,9.90\">The present study measures a local CPU service with no metadata lookup.</p></div>\n<div xmlns=\"http://www.tei-c.org/ns/1.0\"><head n=\"2\" xml:id=\"_fRD4umU\" coords=\"1,50.00,304.44,59.50,12.60\">Methods</head><p xml:id=\"_Edv6atk\" coords=\"1,50.00,334.49,336.33,9.90\">We generated two pages containing a title, abstract, methods and references.</p><p xml:id=\"_GyhACb2\" coords=\"1,50.00,355.49,316.14,9.90\">All paragraphs and reference records were written for this software test.</p><p xml:id=\"_6TaDNJD\" coords=\"1,50.00,376.49,331.45,9.90\">The original bytes remain unchanged during repeated structured extraction.</p></div>\n<div xmlns=\"http://www.tei-c.org/ns/1.0\"><head n=\"3\" xml:id=\"_XYJYpmx\" coords=\"2,50.00,52.44,51.73,12.60\">Results</head><p xml:id=\"_BJEeBcj\" coords=\"2,50.00,82.49,315.87,9.90\">The experiment reports cold and warm service request times separately.</p><p xml:id=\"_bhgWY2E\" coords=\"2,50.00,103.49,325.35,9.90\">A successful request is not a claim of exhaustive text or citation accuracy.</p><p xml:id=\"_fSjbcQa\" coords=\"2,50.00,124.49,329.92,9.90\">The CPU runtime returns page surfaces and region coordinates in raw TEI.</p></div>\n<div xmlns=\"http://www.tei-c.org/ns/1.0\"><head n=\"4\" xml:id=\"_akTyBJ8\" coords=\"2,50.00,143.44,71.95,12.60\">Discussion</head><p xml:id=\"_X6GjGab\" coords=\"2,50.00,173.49,303.37,9.90\">Learned extraction can omit or misclassify synthetic scholarly fields.</p><p xml:id=\"_NdCN2EU\" coords=\"2,50.00,194.49,319.24,9.90\">Raw evidence is retained so that downstream projections can be audited.</p></div>\t\t</body>\n\t\t<back>\n\t\t\t<div type=\"references\">\n\n\t\t\t\t<listBibl>\n\n<biblStruct coords=\"2,50.00,243.49,320.79,9.90;2,50.00,264.49,329.99,9.90\" status=\"extracted\" xml:id=\"b0\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\" coords=\"2,212.84,243.49,153.42,9.90\" xml:id=\"_WvjSpCq\">Reproducible document processing</title>\n\t\t<author>\n\t\t\t<persName coords=\"\"><forename type=\"first\">A</forename><surname>Example</surname></persName>\n\t\t</author>\n\t\t<author>\n\t\t\t<persName coords=\"\"><forename type=\"first\">B</forename><surname>Sample</surname></persName>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.5555/synthetic.2024</idno>\n\t</analytic>\n\t<monogr>\n\t\t<title level=\"j\" xml:id=\"_ugcgNVF\" coords=\"2,50.00,264.49,127.45,9.90\">Journal of Synthetic Methods</title>\n\t\t<imprint>\n\t\t\t<biblScope unit=\"volume\">12</biblScope>\n\t\t\t<biblScope unit=\"issue\">3</biblScope>\n\t\t\t<biblScope unit=\"page\" from=\"100\" to=\"110\" />\n\t\t\t<date type=\"published\" when=\"2024\">2024</date>\n\t\t</imprint>\n\t</monogr>\n\t<note type=\"raw_reference\">Example, A. and Sample, B. (2024). Reproducible document processing. Journal of Synthetic Methods, 12(3), 100-110. doi:10.5555/synthetic.2024.</note>\n</biblStruct>\n\n<biblStruct coords=\"2,50.00,285.49,307.01,9.90;2,50.00,306.49,178.13,9.90\" status=\"extracted\" xml:id=\"b1\">\n\t<analytic>\n\t\t<title level=\"a\" type=\"main\" coords=\"2,134.32,285.49,150.94,9.90\" xml:id=\"_GN8MZHZ\">Provenance in scholarly extraction</title>\n\t\t<author>\n\t\t\t<persName coords=\"\"><forename type=\"first\">C</forename><surname>Reader</surname></persName>\n\t\t</author>\n\t\t<idno type=\"DOI\">10.5555/synthetic.2025</idn